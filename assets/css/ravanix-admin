/* Vazirmatn font — free, SIL OFL license. The actual font files must be placed in
   assets/fonts/vazirmatn/ (see that folder's README.txt for details).
   If the files are absent, the browser automatically falls back to alternate fonts. */
@font-face {
	font-family: 'Vazirmatn';
	src: url('../fonts/vazirmatn/Vazirmatn-Regular.woff2') format('woff2');
	font-weight: 400;
	font-style: normal;
	font-display: swap;
}
@font-face {
	font-family: 'Vazirmatn';
	src: url('../fonts/vazirmatn/Vazirmatn-Medium.woff2') format('woff2');
	font-weight: 500;
	font-style: normal;
	font-display: swap;
}
@font-face {
	font-family: 'Vazirmatn';
	src: url('../fonts/vazirmatn/Vazirmatn-SemiBold.woff2') format('woff2');
	font-weight: 600;
	font-style: normal;
	font-display: swap;
}
@font-face {
	font-family: 'Vazirmatn';
	src: url('../fonts/vazirmatn/Vazirmatn-Bold.woff2') format('woff2');
	font-weight: 700;
	font-style: normal;
	font-display: swap;
}

.rs-wrap[dir="rtl"] {
	direction: rtl;
	text-align: right;
	font-family: 'Vazirmatn', Tahoma, sans-serif;
}

.rs-wrap[dir="rtl"] input,
.rs-wrap[dir="rtl"] textarea,
.rs-wrap[dir="rtl"] select,
.rs-wrap[dir="rtl"] button,
.rs-wrap[dir="rtl"] .button {
	font-family: 'Vazirmatn', Tahoma, sans-serif;
}

.rs-wrap[dir="ltr"] {
	direction: ltr;
	text-align: left;
}

.rs-wrap[dir="rtl"] .form-table th {
	text-align: right;
}

.rs-wrap[dir="ltr"] .form-table th {
	text-align: left;
}

.rs-table {
	/* This table's direction is inherited from its parent (.rs-wrap[dir=...]); no
	   purpose no fixed direction is forced, so that on left-to-right sites the
	   column layout itself (not just text alignment) also displays correctly in LTR. */
}

.rs-badge {
	display: inline-block;
	padding: 2px 10px;
	border-radius: 999px;
	font-size: 0.85em;
	background: #e8eef8;
	color: #2c5fa8;
}

.rs-badge-green {
	background: #e6f6ea;
	color: #2a8a45;
}

.rs-badge-gray {
	background: #f0f0f0;
	color: #666;
}

.rs-link-danger {
	color: #d9534f;
}

.rs-tab-content {
	background: #fff;
	border: 1px solid #ccd0d4;
	border-top: none;
	padding: 20px;
	max-width: 1200px;
}

.rs-columns {
	display: flex;
	gap: 30px;
	flex-wrap: wrap;
}

.rs-col-form {
	flex: 0 0 360px;
	background: #f9f9f9;
	border: 1px solid #eee;
	border-radius: 8px;
	padding: 16px 20px;
	height: fit-content;
}

.rs-col-list {
	flex: 1;
	min-width: 320px;
}

.rs-option-row {
	display: flex;
	gap: 8px;
	margin-bottom: 6px;
}

.rs-option-row .rs-option-dimension {
	flex: 1;
	min-width: 180px;
}

.rs-extra-dimension-row {
	display: flex;
	gap: 8px;
	align-items: center;
	margin-bottom: 6px;
}

.rs-extra-dimension-row select {
	flex: 1;
	min-width: 180px;
}

.rs-color-dot {
	display: inline-block;
	width: 14px;
	height: 14px;
	border-radius: 50%;
	vertical-align: middle;
}

.rs-checklist {
	list-style: none;
	margin: 0 0 20px;
	padding: 0;
}

.rs-checklist li {
	padding: 6px 0;
}

.rs-checklist li.ok {
	color: #2a8a45;
}

.rs-checklist li.warn {
	color: #b3651a;
}

.rs-preview-list {
	max-width: 700px;
}

.rs-preview-list li {
	margin-bottom: 8px;
}

.rs-bulk-import-box {
	background: #f0f6ff;
	border: 1px solid #cfe0f7;
	border-radius: 8px;
	padding: 16px 20px;
	margin-bottom: 20px;
}

.rs-bulk-row {
	display: flex;
	gap: 20px;
	flex-wrap: wrap;
}

.rs-bulk-options-paste {
	background: #fafafa;
	border: 1px dashed #ccc;
	border-radius: 6px;
	padding: 10px;
	margin-bottom: 12px;
}

.rs-related-questionnaires {
	margin-top: 30px;
	padding-top: 15px;
	border-top: 1px solid #eee;
}

.rs-assign-form {
	display: flex;
	gap: 6px;
	align-items: center;
}

.rs-assign-form input[type="text"] {
	width: 160px;
}

.rs-category-checklist {
	max-height: 160px;
	overflow-y: auto;
	border: 1px solid #ddd;
	border-radius: 6px;
	padding: 8px 12px;
	background: #fafafa;
	margin-bottom: 8px;
	max-width: 400px;
}

.rs-category-item {
	display: block;
	margin-bottom: 4px;
}

/* Feed columns (psykey.ir shop/blog) on the Settings page */
.rs-feed-columns {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 20px;
	max-width: 900px;
	margin-top: 10px;
}

@media (max-width: 782px) {
	.rs-feed-columns {
		grid-template-columns: 1fr;
	}
}

.rs-feed-column {
	background: #fff;
	border: 1px solid #dcdcde;
	border-radius: 8px;
	padding: 16px 18px;
}

.rs-feed-column h3 {
	margin-top: 0;
	margin-bottom: 6px;
	font-size: 15px;
}

.rs-feed-list {
	margin: 10px 0 0;
	padding: 0;
	list-style: none;
}

.rs-feed-list li {
	padding: 8px 0;
	border-bottom: 1px solid #f0f0f1;
}

.rs-feed-list li:last-child {
	border-bottom: none;
}

.rs-feed-list a {
	text-decoration: none;
	color: #2271b1;
}

.rs-feed-list a:hover {
	text-decoration: underline;
}

/* ---------------- Upgrade to Pro page ---------------- */

.rs-upgrade-lede {
	max-width: 760px;
	font-size: 14px;
	color: #50575e;
}

.rs-compare-table-wrap {
	max-width: 900px;
	margin-top: 20px;
	background: #fff;
	border: 1px solid #e2e4e7;
	border-radius: 10px;
	overflow: hidden;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
}

.rs-compare-table {
	width: 100%;
	border-collapse: collapse;
	font-size: 13px;
}

.rs-compare-table thead th {
	background: #fbfbfc;
	border-bottom: 1px solid #e2e4e7;
	padding: 10px 16px;
	font-weight: 600;
	color: #1d2327;
	text-align: right;
}

.rs-compare-table thead th.rs-compare-col {
	text-align: center;
}

.rs-compare-table thead th.rs-compare-col-pro {
	color: #a9760e;
}

.rs-compare-table .rs-compare-group-row th {
	background: #f6f7f7;
	font-weight: 600;
	font-size: 12px;
	color: #646970;
	padding: 7px 16px;
	border-top: 1px solid #e2e4e7;
	border-bottom: 1px solid #ececec;
}

.rs-compare-table tbody tr:not(.rs-compare-group-row) {
	border-bottom: 1px solid #f0f0f1;
	transition: background-color 0.12s ease;
}

.rs-compare-table tbody tr:not(.rs-compare-group-row):last-child {
	border-bottom: none;
}

.rs-compare-table tbody tr:not(.rs-compare-group-row):hover {
	background-color: #f7f9fc;
}

.rs-compare-table tbody tr:not(.rs-compare-group-row):hover .rs-compare-col-pro {
	background-color: #fdf3e0;
}

.rs-compare-table td {
	padding: 9px 16px;
	vertical-align: middle;
	line-height: 1.5;
	color: #2c3338;
}

.rs-compare-col {
	width: 90px;
	text-align: center;
}

.rs-compare-col-pro {
	background: #fef8ec;
	transition: background-color 0.12s ease;
}

.rs-compare-icon {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 22px;
	height: 22px;
	border-radius: 50%;
	font-size: 13px;
}

.rs-compare-icon.rs-yes {
	background: #eaf7ec;
	color: #3fae54;
}

.rs-compare-icon.rs-no {
	background: #f3f3f4;
	color: #c3c4c7;
}

.rs-compare-icon .dashicons {
	font-size: 15px;
	width: 15px;
	height: 15px;
}

.rs-upgrade-cta {
	margin-top: 24px;
	max-width: 900px;
}

.rs-upgrade-cta .button-hero {
	background: #e0a72e;
	border-color: #c8931f;
	transition: background-color 0.15s ease, transform 0.1s ease;
}

.rs-upgrade-cta .button-hero:hover {
	background: #c8931f;
	transform: translateY(-1px);
}

.rs-upgrade-cta .description {
	margin-top: 10px;
}

@media (max-width: 782px) {
	.rs-compare-table-wrap {
		overflow-x: auto;
	}
	.rs-compare-table {
		min-width: 480px;
	}
	.rs-compare-col {
		width: auto;
	}
}
